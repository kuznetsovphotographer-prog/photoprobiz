{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "photoprobiz-lead-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "api.photoprobiz.ru",
      "custom_domain": true
    }
  ]
}
